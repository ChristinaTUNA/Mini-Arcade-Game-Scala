<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="xy.christina.game.view.RootLayoutController">
   <bottom>
      <ButtonBar buttonMinWidth="30.0" prefHeight="53.0" prefWidth="600.0" BorderPane.alignment="CENTER">
        <buttons>
            <Button contentDisplay="CENTER" lineSpacing="10.0" minWidth="49.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="30.0" text="PAUSE" textAlignment="CENTER" />
            <Button contentDisplay="CENTER" lineSpacing="10.0" mnemonicParsing="false" onAction="#handleQuitGame" text="EXIT" textAlignment="CENTER">
               <font>
                  <Font name="Century Schoolbook" size="12.0" />
               </font></Button>
            <Button contentDisplay="CENTER" lineSpacing="10.0" mnemonicParsing="false" text="MUTE" textAlignment="CENTER" />
        </buttons>
         <padding>
            <Insets bottom="10.0" right="30.0" />
         </padding>
         <effect>
            <DropShadow height="0.0" offsetX="1.0" offsetY="2.0" radius="0.0" spread="0.04" width="1.72" />
         </effect>
      </ButtonBar>
   </bottom>
</BorderPane>
